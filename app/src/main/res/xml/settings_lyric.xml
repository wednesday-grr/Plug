<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <PreferenceCategory
        android:layout="@layout/preference_category_md"
        android:title="@string/settings_lyric_cat_general">

    <SwitchPreferenceCompat
        android:defaultValue="false"
        android:key="lyric_center"
        android:layout="@layout/preference_switch"
        android:summary="@string/settings_lyrics_center_summary"
        android:title="@string/settings_lyrics_center"
        android:widgetLayout="@layout/preference_switch_widget"
        app:iconSpaceReserved="false" />

    <SwitchPreferenceCompat
        android:defaultValue="true"
        android:key="lyric_apple_music_effects"
        android:layout="@layout/preference_switch"
        android:summary="@string/settings_lyrics_apple_music_effects_summary"
        android:title="@string/settings_lyrics_apple_music_effects"
        android:widgetLayout="@layout/preference_switch_widget"
        app:iconSpaceReserved="false" />

    <SwitchPreferenceCompat
        android:defaultValue="false"
        android:key="lyric_custom_active_enabled"
        android:title="@string/settings_lyric_custom_active"
        android:summary="@string/settings_lyric_custom_color_summary"
        app:iconSpaceReserved="false" />
    <EditTextPreference
        android:defaultValue="#FFFFFF"
        android:dependency="lyric_custom_active_enabled"
        android:key="lyric_custom_active_color"
        android:title="@string/settings_lyric_active_color"
        app:useSimpleSummaryProvider="true"
        app:iconSpaceReserved="false" />
    <SwitchPreferenceCompat
        android:defaultValue="false"
        android:key="lyric_custom_inactive_enabled"
        android:title="@string/settings_lyric_custom_inactive"
        android:summary="@string/settings_lyric_custom_color_summary"
        app:iconSpaceReserved="false" />
    <EditTextPreference
        android:defaultValue="#BDBDBD"
        android:dependency="lyric_custom_inactive_enabled"
        android:key="lyric_custom_inactive_color"
        android:title="@string/settings_lyric_inactive_color"
        app:useSimpleSummaryProvider="true"
        app:iconSpaceReserved="false" />
    <SwitchPreferenceCompat
        android:defaultValue="false"
        android:dependency="lyric_apple_music_effects"
        android:key="lyric_custom_brightness_enabled"
        android:title="@string/settings_lyric_custom_brightness"
        android:summary="@string/settings_lyric_custom_brightness_summary"
        app:iconSpaceReserved="false" />
    <SeekBarPreference
        android:defaultValue="70"
        android:dependency="lyric_custom_brightness_enabled"
        android:key="lyric_custom_brightness"
        android:max="100"
        android:title="@string/settings_lyric_brightness"
        app:min="0"
        app:showSeekBarValue="true"
        app:iconSpaceReserved="false" />

    <SeekBarPreference
        android:defaultValue="34"
        android:icon="@drawable/ic_font_size"
        android:key="lyric_text_size"
        android:layout="@layout/preference_seekbar"
        app:min="26"
        android:max="40"
        android:title="@string/settings_font_size"
        app:showSeekBarValue="true" />

    <SwitchPreferenceCompat
        android:defaultValue="false"
        android:key="status_bar_lyrics"
        android:layout="@layout/preference_switch"
        android:summary="@string/settings_status_bar_lyrics_summary"
        android:title="@string/settings_status_bar_lyrics_title"
        android:widgetLayout="@layout/preference_switch_widget"
        app:iconSpaceReserved="false" />

    <SwitchPreferenceCompat
        android:defaultValue="false"
        android:key="notification_lyrics"
        android:layout="@layout/preference_switch"
        android:summary="@string/settings_notification_lyrics_summary"
        android:title="@string/settings_notification_lyrics_title"
        android:widgetLayout="@layout/preference_switch_widget"
        app:iconSpaceReserved="false" />

    <SwitchPreferenceCompat
        android:defaultValue="true"
        android:key="trim_lyrics"
        android:layout="@layout/preference_switch"
        android:summary="@string/settings_trim_lyrics_summary"
        android:title="@string/settings_trim_lyrics"
        android:widgetLayout="@layout/preference_switch_widget"
        app:iconSpaceReserved="false" />

    <SwitchPreferenceCompat
        android:defaultValue="false"
        android:key="lyric_no_animation"
        android:layout="@layout/preference_switch"
        android:summary="@string/settings_lyrics_no_animation_summary"
        android:title="@string/settings_lyrics_no_animation"
        android:widgetLayout="@layout/preference_switch_widget"
        app:iconSpaceReserved="false" />

    <SeekBarPreference
        android:defaultValue="200"
        android:key="lyric_word_expansion_duration"
        android:max="1000"
        android:title="@string/settings_lyric_word_expansion_duration"
        app:min="50"
        app:showSeekBarValue="true"
        app:iconSpaceReserved="false" />

    </PreferenceCategory>

    <PreferenceCategory
        android:layout="@layout/preference_category_md"
        android:title="@string/settings_lyric_cat_online">

    <SwitchPreferenceCompat
        android:defaultValue="false"
        android:key="translation_auto_word"
        android:layout="@layout/preference_switch"
        android:summary="@string/settings_translation_auto_word_summary"
        android:title="@string/settings_translation_auto_word"
        android:widgetLayout="@layout/preference_switch_widget"
        app:iconSpaceReserved="false" />

    <SwitchPreferenceCompat
        android:defaultValue="false"
        android:key="spicy_lyrics_enabled"
        android:layout="@layout/preference_switch"
        android:summary="@string/settings_spicy_lyrics_summary"
        android:title="@string/settings_spicy_lyrics_title"
        android:widgetLayout="@layout/preference_switch_widget"
        app:iconSpaceReserved="false" />

    <SwitchPreferenceCompat
        android:defaultValue="true"
        android:key="lrclib_enabled"
        android:layout="@layout/preference_switch"
        android:title="@string/settings_lrclib_enabled"
        android:summary="@string/settings_lrclib_enabled_summary"
        android:widgetLayout="@layout/preference_switch_widget"
        app:iconSpaceReserved="false" />

    <EditTextPreference
        android:dependency="spicy_lyrics_enabled"
        android:defaultValue="sl_pk_xbRfEl3A28te21Eq9Kd7B6hU14DrdKx79ISGiWCXpvk"
        android:dialogTitle="@string/settings_spicy_lyrics_api_key_dialog"
        android:key="spicy_lyrics_api_key"
        android:inputType="textPassword"
        android:summary="@string/settings_spicy_lyrics_api_key_summary"
        android:title="@string/settings_spicy_lyrics_api_key_title"
        app:iconSpaceReserved="false" />

    <Preference
        android:key="lyric_cache_clear"
        android:title="@string/settings_lyric_cache_clear"
        android:summary="@string/settings_lyric_cache_clear_summary"
        app:iconSpaceReserved="false" />

    </PreferenceCategory>

    <PreferenceCategory android:layout="@layout/preference_category_md" android:title="@string/settings_lyric_cat_spring_primary">
        <SeekBarPreference android:key="lyric_spring_primary_duration" android:title="@string/settings_lyric_spring_duration" android:defaultValue="800" android:max="2000" app:min="100" app:showSeekBarValue="true" app:iconSpaceReserved="false" />
        <SeekBarPreference android:key="lyric_spring_primary_stiffness" android:title="@string/settings_lyric_spring_stiffness" android:defaultValue="100" android:max="500" app:min="10" app:showSeekBarValue="true" app:iconSpaceReserved="false" />
        <SeekBarPreference android:key="lyric_spring_primary_damping" android:title="@string/settings_lyric_spring_damping" android:defaultValue="15" android:max="50" app:min="1" app:showSeekBarValue="true" app:iconSpaceReserved="false" />
        <SeekBarPreference android:key="lyric_spring_primary_mass" android:title="@string/settings_lyric_spring_mass" android:defaultValue="10" android:max="50" app:min="1" app:showSeekBarValue="true" app:iconSpaceReserved="false" />
    </PreferenceCategory>
    <PreferenceCategory android:layout="@layout/preference_category_md" android:title="@string/settings_lyric_cat_spring_background">
        <SeekBarPreference android:key="lyric_spring_background_duration" android:title="@string/settings_lyric_spring_duration" android:defaultValue="400" android:max="2000" app:min="100" app:showSeekBarValue="true" app:iconSpaceReserved="false" />
        <SeekBarPreference android:key="lyric_spring_background_stiffness" android:title="@string/settings_lyric_spring_stiffness" android:defaultValue="100" android:max="500" app:min="10" app:showSeekBarValue="true" app:iconSpaceReserved="false" />
        <SeekBarPreference android:key="lyric_spring_background_damping" android:title="@string/settings_lyric_spring_damping" android:defaultValue="15" android:max="50" app:min="1" app:showSeekBarValue="true" app:iconSpaceReserved="false" />
        <SeekBarPreference android:key="lyric_spring_background_mass" android:title="@string/settings_lyric_spring_mass" android:defaultValue="10" android:max="50" app:min="1" app:showSeekBarValue="true" app:iconSpaceReserved="false" />
    </PreferenceCategory>
    <PreferenceCategory android:layout="@layout/preference_category_md" android:title="@string/settings_lyric_cat_spring_scroll">
        <SeekBarPreference android:key="lyric_spring_scroll_duration" android:title="@string/settings_lyric_spring_duration" android:defaultValue="800" android:max="2000" app:min="100" app:showSeekBarValue="true" app:iconSpaceReserved="false" />
        <SeekBarPreference android:key="lyric_spring_scroll_stiffness" android:title="@string/settings_lyric_spring_stiffness" android:defaultValue="100" android:max="500" app:min="10" app:showSeekBarValue="true" app:iconSpaceReserved="false" />
        <SeekBarPreference android:key="lyric_spring_scroll_damping" android:title="@string/settings_lyric_spring_damping" android:defaultValue="15" android:max="50" app:min="1" app:showSeekBarValue="true" app:iconSpaceReserved="false" />
        <SeekBarPreference android:key="lyric_spring_scroll_mass" android:title="@string/settings_lyric_spring_mass" android:defaultValue="10" android:max="50" app:min="1" app:showSeekBarValue="true" app:iconSpaceReserved="false" />
    </PreferenceCategory>

</PreferenceScreen>