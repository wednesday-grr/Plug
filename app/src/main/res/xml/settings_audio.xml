<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <PreferenceCategory
        android:layout="@layout/preference_category_md"
        android:title="@string/settings_automix_category">

        <SwitchPreferenceCompat
            android:defaultValue="false"
            android:key="automix_enabled"
            android:layout="@layout/preference_switch"
            android:summary="@string/settings_automix_description"
            android:title="@string/settings_automix_enabled"
            android:widgetLayout="@layout/preference_switch_widget"
            app:icon="@drawable/ic_automix"
            app:iconSpaceReserved="true" />


        <SwitchPreferenceCompat
            android:defaultValue="true"
            android:dependency="automix_enabled"
            android:key="automix_beatmatch_enabled"
            android:layout="@layout/preference_switch"
            android:title="@string/settings_automix_beatmatch"
            android:widgetLayout="@layout/preference_switch_widget"
            app:iconSpaceReserved="true" />

        <ListPreference
            android:defaultValue="existing"
            android:entries="@array/automix_analyzer_entries"
            android:entryValues="@array/automix_analyzer_values"
            android:key="automix_analyzer"
            android:layout="@layout/preference_basic"
            android:title="@string/settings_automix_analyzer"
            android:summary="@string/settings_automix_analyzer_summary"
            app:iconSpaceReserved="true" />

        <ListPreference
            android:defaultValue="auto"
            android:dependency="automix_enabled"
            android:entries="@array/automix_transition_styles"
            android:entryValues="@array/automix_transition_style_values"
            android:key="automix_transition_style"
            android:layout="@layout/preference_basic"
            android:title="@string/settings_automix_transition_style"
            app:iconSpaceReserved="true" />

        <ListPreference
            android:defaultValue="4"
            android:dependency="automix_enabled"
            android:entries="@array/automix_loop_beat_entries"
            android:entryValues="@array/automix_loop_beat_values"
            android:key="automix_loop_transition_beats"
            android:layout="@layout/preference_basic"
            android:title="@string/settings_automix_loop_transition_beats"
            android:summary="%s"
            app:iconSpaceReserved="true" />

        <SeekBarPreference
            android:defaultValue="50"
            android:dependency="automix_enabled"
            android:key="automix_fade_curve_intensity"
            android:layout="@layout/preference_seekbar"
            android:max="100"
            android:title="@string/settings_automix_fade_curve_intensity"
            android:summary="@string/settings_automix_fade_curve_intensity_summary"
            app:min="0"
            app:showSeekBarValue="true"
            app:updatesContinuously="true"
            app:iconSpaceReserved="true" />

        <SwitchPreferenceCompat
            android:defaultValue="false"
            android:dependency="automix_enabled"
            android:key="automix_loudness_matching"
            android:layout="@layout/preference_switch"
            android:summary="@string/settings_automix_loudness_matching_summary"
            android:title="@string/settings_automix_loudness_matching"
            android:widgetLayout="@layout/preference_switch_widget"
            app:iconSpaceReserved="true" />

        <SwitchPreferenceCompat
            android:defaultValue="false"
            android:dependency="automix_enabled"
            android:key="automix_agc"
            android:layout="@layout/preference_switch"
            android:summary="@string/settings_automix_agc_summary"
            android:title="@string/settings_automix_agc"
            android:widgetLayout="@layout/preference_switch_widget"
            app:iconSpaceReserved="true" />

        <SwitchPreferenceCompat
            android:defaultValue="false"
            android:dependency="automix_enabled"
            android:key="automix_energy_matching"
            android:layout="@layout/preference_switch"
            android:summary="@string/settings_automix_energy_matching_summary"
            android:title="@string/settings_automix_energy_matching"
            android:widgetLayout="@layout/preference_switch_widget"
            app:iconSpaceReserved="true" />

        <SwitchPreferenceCompat
            android:defaultValue="false"
            android:dependency="automix_enabled"
            android:key="automix_bass_boost"
            android:layout="@layout/preference_switch"
            android:summary="@string/settings_automix_bass_boost_summary"
            android:title="@string/settings_automix_bass_boost"
            android:widgetLayout="@layout/preference_switch_widget"
            app:iconSpaceReserved="true" />

        <SeekBarPreference
            android:defaultValue="4"
            android:dependency="automix_bass_boost"
            android:key="automix_bass_boost_gain_db"
            android:layout="@layout/preference_seekbar"
            android:max="12"
            android:title="@string/settings_automix_bass_boost_gain"
            app:min="0"
            app:showSeekBarValue="true"
            app:updatesContinuously="true"
            app:iconSpaceReserved="true" />

        <SeekBarPreference
            android:defaultValue="100"
            android:dependency="automix_bass_boost"
            android:key="automix_bass_boost_frequency_hz"
            android:layout="@layout/preference_seekbar"
            android:max="250"
            android:title="@string/settings_automix_bass_boost_frequency"
            app:min="40"
            app:showSeekBarValue="true"
            app:updatesContinuously="true"
            app:iconSpaceReserved="true" />
        <MultiSelectListPreference
            android:dependency="automix_enabled"
            android:entries="@array/automix_additional_effects"
            android:entryValues="@array/automix_additional_effect_values"
            android:key="automix_additional_effects"
            android:layout="@layout/preference_basic"
            android:title="@string/settings_automix_additional_effects"
            android:summary="@string/settings_automix_additional_effects_summary"
            app:iconSpaceReserved="true" />

        <SeekBarPreference
            android:defaultValue="100"
            android:dependency="automix_enabled"
            android:key="automix_effect_intensity"
            android:layout="@layout/preference_seekbar"
            android:max="100"
            android:title="@string/settings_automix_effect_intensity"
            android:summary="@string/settings_automix_effect_intensity_summary"
            app:min="0"
            app:showSeekBarValue="true"
            app:updatesContinuously="true"
            app:iconSpaceReserved="true" />

        <SwitchPreferenceCompat
            android:defaultValue="false"
            android:dependency="automix_enabled"
            android:disableDependentsState="true"
            android:key="automix_duration_auto"
            android:layout="@layout/preference_switch"
            android:summary="@string/settings_automix_duration_auto_summary"
            android:title="@string/settings_automix_duration_auto"
            android:widgetLayout="@layout/preference_switch_widget"
            app:iconSpaceReserved="true" />

        <SeekBarPreference
            android:defaultValue="5"
            android:dependency="automix_duration_auto"
            android:key="automix_duration_sec"
            android:layout="@layout/preference_seekbar"
            android:max="30"
            android:title="@string/settings_automix_duration"
            app:min="1"
            app:showSeekBarValue="true"
            app:updatesContinuously="true"
            app:iconSpaceReserved="true" />

        <SeekBarPreference
            android:defaultValue="15"
            android:dependency="automix_enabled"
            android:key="automix_max_skip_sec"
            android:layout="@layout/preference_seekbar"
            android:max="30"
            android:title="@string/settings_automix_max_skip"
            android:summary="@string/settings_automix_max_skip_summary"
            app:min="0"
            app:showSeekBarValue="true"
            app:updatesContinuously="true"
            app:iconSpaceReserved="true" />

    </PreferenceCategory>

    <PreferenceCategory
        android:layout="@layout/preference_category_md"
        android:title="@string/settings_category_misc">

        <Preference
            android:key="replaygain"
            android:layout="@layout/preference_basic"
            android:title="@string/settings_replaygain"
            app:iconSpaceReserved="false" />

    </PreferenceCategory>

    <PreferenceCategory
        android:key="rg_boost_gain_category"
        android:title="@string/settings_replaygain_boost"
        app:iconSpaceReserved="false">

        <DecibelSeekBarPreference
            android:defaultValue="0"
            android:icon="@drawable/outline_volume_up_24"
            android:key="rg_boost_gain"
            android:layout="@layout/preference_seekbar"
            android:max="15"
            android:title="@string/settings_replaygain_boost"
            app:showSeekBarValue="true" />

        <Preference
            android:icon="@drawable/ic_info"
            android:layout="@layout/preference_basic"
            android:summary="@string/settings_replaygain_boost_desc" />

    </PreferenceCategory>

</PreferenceScreen>