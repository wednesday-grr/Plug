<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <PreferenceCategory
        android:layout="@layout/preference_category_md"
        android:title="@string/settings_stem_cat_transitions">

        <!-- Enabled state follows automix_enabled in StemSettingsFragment (android:dependency cannot cross screens). -->
        <SwitchPreferenceCompat
            android:defaultValue="false"
            android:key="automix_stem_transitions"
            android:layout="@layout/preference_switch"
            android:summary="@string/settings_stem_transitions_summary"
            android:title="@string/settings_stem_transitions"
            android:widgetLayout="@layout/preference_switch_widget"
            app:iconSpaceReserved="false" />

    </PreferenceCategory>

    <PreferenceCategory
        android:layout="@layout/preference_category_md"
        android:title="@string/settings_stem_cat_storage">

        <Preference
            android:key="stem_model"
            android:layout="@layout/preference_basic"
            android:title="@string/settings_stem_model"
            app:iconSpaceReserved="false" />

        <Preference
            android:key="stem_cache"
            android:layout="@layout/preference_basic"
            android:title="@string/settings_stem_cache"
            app:iconSpaceReserved="false" />

    </PreferenceCategory>

</PreferenceScreen>
